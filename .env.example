# Keep DATABASE_URL from your deployment environment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google Auth Platform > Clients > Web application.
# Never prefix these server-only values with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate a random key, for example with: openssl rand -hex 32
# Minimum 32 characters. Keep stable after connecting a channel.
YOUTUBE_TOKEN_SECRET=

# Local development only. For deployment or Cloudflare Tunnel, use the current HTTPS origin.
# Example tunnel value: https://your-current-tunnel.trycloudflare.com
# No path, query string, fragment, or trailing slash.
# .env.local (and process-level variables) can override this value. Restart after editing.
APP_URL=http://localhost:3000

# This is a comment, NOT a setting that updates Google Cloud:
# Authorized redirect URI = APP_URL + /api/youtube/callback
# Paste that FULL URI into Google Auth Platform > Clients > Authorized redirect URIs.
# Never paste only the bare APP_URL there.
# If an encryption key is disclosed, rotate it privately and reconnect affected channels.
